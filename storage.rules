rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
    }
    
    match /products/files/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /products/images/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /applications/{fileName} {
      allow write: if request.auth != null;
    }
    
    match /deliverables/{fileName} {
      allow write: if request.auth != null;
    }
    
    match /proofs/{fileName} {
      allow write: if request.auth != null;
    }
    
    match /avatars/{userId}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
